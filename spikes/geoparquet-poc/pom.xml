<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>eu.esdihumboldt.spike</groupId>
  <artifactId>geoparquet-poc</artifactId>
  <version>0.1</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Real runtime write path: pure-Java parquet-column/common (no Arrow, no GeoArrow) -->
    <dependency>
      <groupId>org.apache.parquet</groupId>
      <artifactId>parquet-hadoop</artifactId>
      <version>1.17.1</version>
      <!--
        snappy-java and zstd-jni are native/JNI-backed compression codecs, declared
        as plain (non-optional) compile-scope dependencies in parquet-hadoop 1.17.1's
        own POM, so they are pulled in unconditionally by default - together ~9.7MB of
        mostly bundled per-platform native binaries. Confirmed by testing that they are
        NOT load-bearing for this PoC's UNCOMPRESSED-codec write path: excluding both,
        the writer still produces a file independently validated as GeoParquet-2.0.0-rc.1-
        compliant (see validate.py). Note: parquet-hadoop's stock CodecFactory still
        constructs a Hadoop Configuration for any codec other than UNCOMPRESSED (see
        NOTES.md, "Compression codec correction"); compressed output goes through
        PureJavaCodecFactory (aircompressor, below) instead.
      -->
      <exclusions>
        <exclusion>
          <groupId>org.xerial.snappy</groupId>
          <artifactId>snappy-java</artifactId>
        </exclusion>
        <exclusion>
          <groupId>com.github.luben</groupId>
          <artifactId>zstd-jni</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      hadoop-common is needed ONLY to satisfy javac when compiling against
      ExampleParquetWriter/ParquetWriter.Builder's inherited API surface
      (abstract getWriteSupport(Configuration) / withConf(Configuration) overloads).
      scope=provided => NOT packaged, NOT on the runtime classpath we test with.
      This is exactly the thing the PoC needs to prove: that it's truly unused at runtime.
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>3.3.0</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      Pure-Java ZSTD/Snappy/LZ4 used directly by PureJavaCodecFactory (Hadoop-free
      compression). Already a transitive dependency of parquet-hadoop (2.0.2); declared
      explicitly at 2.0.3, the version hale-core pins in gradle/libs.versions.toml (CVE fix).
    -->
    <dependency>
      <groupId>io.airlift</groupId>
      <artifactId>aircompressor</artifactId>
      <version>2.0.3</version>
    </dependency>

    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
      <version>1.20.0</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.13</version>
    </dependency>

    <!--
      Used ONLY by GeoPackageToGeoParquet to read this PoC's real-world test input
      (data/*.gpkg). It is native/JNI-backed (bundles SQLite) and is explicitly NOT part
      of the GeoParquet *write* path's dependency footprint being evaluated by this PoC -
      a real hale plugin would read GeoPackage input via hale-core's existing GeoPackage
      reader, not this shortcut.
    -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.46.1.3</version>
    </dependency>
  </dependencies>
</project>
